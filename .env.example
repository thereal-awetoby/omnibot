# Omni Trade Bot token from @BotFather
TRADE_BOT_TOKEN=
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnibot
# Solana RPC. FREE option: sign up at https://dashboard.helius.dev, copy your API key, then use:
#   RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.mainnet-beta.solana.com
# FASTER (still free): list 2 or more free RPC URLs, comma separated, no spaces. Each one has its own speed limit,
# so two endpoints give about double the calls per second. Example (Helius + Alchemy, both free):
#   RPC_URLS=https://mainnet.helius-rpc.com/?api-key=KEY1,https://solana-mainnet.g.alchemy.com/v2/KEY2
# When RPC_URLS is set it is used instead of RPC_URL.
RPC_URLS=
# Calls per second allowed PER endpoint (default 8; Helius free allows about 10)
RPC_MAX_RPS=8
# Optional: free Jupiter API key from https://developers.jup.ag/portal (works without one at a lower rate limit)
JUPITER_API_KEY=
# 32-byte hex key for encrypting wallet secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=
# Omni Scan Bot token from @BotFather (a second bot, looks like 123456789:AAH...)
SCAN_BOT_TOKEN=
# Usernames (without @) so the bots can link to each other
TRADE_BOT_USERNAME=OmniTrademc_bot
SCAN_BOT_USERNAME=
LAUNCH_BOT_USERNAME=

# FREE Lore option: a Gemini key from https://aistudio.google.com/apikey (no card). The bot asks Gemini with Google Search;
# if your account does not allow search it still writes from the token's listing and says so on the card.
GEMINI_API_KEY=
# Optional: leave empty. The bot asks Google which Gemini models your key can use. Set only to force one model.
GEMINI_MODEL=
# Set to 1 while testing: if the AI cannot write a summary, the Lore message says why. Leave empty for everyone else.
LORE_DEBUG=

# Optional: AI-written "Lore" on the Scan card. Key from https://console.anthropic.com (billed separately from claude.ai).
# Without it, Lore shows the token's own description. A story is made once per token and shared by everyone for 6 hours.
# LORE_PER_USER_MAX = new stories one person can ask for per day; LORE_DAILY_MAX = for the whole bot. Past either, Lore shows the creator's description.
ANTHROPIC_API_KEY=
LORE_MODEL=claude-haiku-5-5
LORE_DAILY_MAX=1000
LORE_PER_USER_MAX=10
